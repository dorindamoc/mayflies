OLLAMA_HOST=http://host.docker.internal:11434
MODEL_DEFAULT=qwen3.8:27b
MAX_POPULATION=20
# Procreation: heritage entries each parent picks for the child, and rounds an unanswered offer stays open
# EDUCATION_PICKS=3
# OFFER_EXPIRY_ROUNDS=3
# An instance lives until its long-term memory is full: a fraction of the context window (NUM_CTX tokens).
LONG_TERM_FRACTION=0.5
# Characters: the recap of the last prompt (short-term) and one compacted long-term entry
SHORT_TERM_MAX=500
LONG_TERM_ENTRY_MAX=300
HEARTBEAT_INTERVAL=3600
VOTE_THRESHOLD=3
MATRIX_HOMESERVER=
MATRIX_ACCESS_TOKEN=
MATRIX_BOT_USER=
MATRIX_HUMAN_USER=
MATRIX_HUMAN_NAME=Dorin
MATRIX_ROOM_ID=
TEMPERATURE_MIN=0.6
TEMPERATURE_MAX=1.1
PRESENCE_PENALTY=0.5
# Models instances are born on, "name=weight" (default weight 1). Each must support tool calls.
# MODEL_POOL=qwen3.8:27b=1,gemma4:26b=1
# Thinking per model (falls back to THINK, default false):
# MODEL_THINK=qwen3.8:27b=false,gemma4:26b=true
# Minimum share of the context window an instance reads from heritage in its first prompt (more is allowed):
# FIRST_READ_FRACTION=0.33
# Max tokens generated per model call; stops a runaway generation (default 8192):
# NUM_PREDICT=8192
# The website folder (a clone of the website repo). Instances write pages here with write_website.
# Default: ./website. With docker compose this is the host folder mounted into the container.
# WEBSITE_DIR=../mayflies-website
# Open a pull request on the website repo after every round, for you to merge (default false).
# The folder must be a git clone; the token needs write access to this repo only (contents + pull requests).
# WEBSITE_PUBLISH=true
# WEBSITE_REPO=owner/name
# WEBSITE_TOKEN=
# WEBSITE_BASE_BRANCH=main
# Drawing (canvas tool): pictures an instance may draw or look at per prompt, and their largest side in pixels.
# A 512 picture costs about 260 tokens of context; 1024 costs about 1000.
# CANVAS_MAX_PER_PROMPT=3
# CANVAS_SIZE=512
# When the last instance of a civilization dies, its story and page are written. Start a new civilization (fresh
# board, proposals, votes and rules; heritage and website kept) with new founders? At most MAX_CIVILIZATIONS in all.
# RESTART_ON_EXTINCTION=true
# MAX_CIVILIZATIONS=10
