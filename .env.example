OLLAMA_HOST=http://host.docker.internal:11434
MODEL_DEFAULT=qwen3.8:27b
MAX_POPULATION=10
# An instance lives until its long-term memory is full: a fraction of the context window (NUM_CTX tokens).
LONG_TERM_FRACTION=0.5
# Characters: the recap of the last prompt (short-term) and one compacted long-term entry
SHORT_TERM_MAX=500
LONG_TERM_ENTRY_MAX=300
HEARTBEAT_INTERVAL=3600
VOTE_THRESHOLD=3
MATRIX_HOMESERVER=
MATRIX_ACCESS_TOKEN=
MATRIX_BOT_USER=
MATRIX_HUMAN_USER=
MATRIX_HUMAN_NAME=Dorin
MATRIX_ROOM_ID=
TEMPERATURE_MIN=0.6
TEMPERATURE_MAX=1.1
PRESENCE_PENALTY=0.5
# Models instances are born on, "name=weight" (default weight 1). Each must support tool calls.
# MODEL_POOL=qwen3.8:27b=1,gemma4:26b=1
# Thinking per model (falls back to THINK, default false):
# MODEL_THINK=qwen3.8:27b=false,gemma4:26b=true
# Minimum share of the context window an instance reads from heritage in its first prompt (more is allowed):
# FIRST_READ_FRACTION=0.33
